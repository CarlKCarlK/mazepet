    "preview": "python3 -m http.server 8000 --bind 127.0.0.1 --directory _site"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
